{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Calc",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/app"
            },
            "problemMatcher": "$gcc",
            "dependsOn": "Configure Calc",
            "group": "build"
        },
        {
            "label": "Configure Calc",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-G",
                "MinGW Makefiles",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/app"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Calc IT",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/test/it"
            },
            "problemMatcher": "$gcc",
            "dependsOn": "Configure Calc IT",
            "group": "build"
        },
        {
            "label": "Configure Calc IT",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-G",
                "MinGW Makefiles",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/test/it"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Calc UT",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/test/ut"
            },
            "problemMatcher": "$gcc",
            "dependsMatcher": "$gcc",
            "dependsOn": "Configure Calc UT",
            "group": "build"
        },
        {
            "label": "Configure Calc UT",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-G",
                "MinGW Makefiles",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/test/ut"
            },
            "problemMatcher": []
        }
    ]
}
