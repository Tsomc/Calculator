{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build App",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/app",
                "env": {
                    "PATH": "D:\\Qt\\Tools\\mingw1310_64\\bin;D:\\Qt\\Tools\\CMake_64\\bin;D:\\Qt\\6.11.0\\mingw_64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": "$gcc",
            "dependsOn": "Configure App",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Configure App",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-G",
                "MinGW Makefiles",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/app",
                "env": {
                    "PATH": "D:\\Qt\\Tools\\mingw1310_64\\bin;D:\\Qt\\Tools\\CMake_64\\bin;D:\\Qt\\6.11.0\\mingw_64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Build Calc IT",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/test/it"
            },
            "problemMatcher": "$gcc",
            "dependsOn": "Configure Calc IT",
            "group": "build"
        },
        {
            "label": "Configure Calc IT",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-G",
                "MinGW Makefiles",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/test/it"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Calc UT",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/test/ut"
            },
            "problemMatcher": "$gcc",
            "dependsOn": "Configure Calc UT",
            "group": "build"
        },
        {
            "label": "Configure Calc UT",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-G",
                "MinGW Makefiles",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/test/ut"
            },
            "problemMatcher": []
        }
    ]
}
